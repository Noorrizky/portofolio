<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>Noor Rizky Permana — Infrastructure Engineer & Fullstack Developer</title>

<meta name="description" content="Portfolio of Noor Rizky Permana — Infrastructure Engineer, Network Engineer, and Fullstack Developer."/>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

<script src="https://cdn.tailwindcss.com"></script>

<script>
tailwind.config = {
    darkMode: 'class',
    theme: {
        extend: {
            fontFamily: {
                sans: ['Inter', 'sans-serif'],
            },
            animation: {
                float: 'float 6s ease-in-out infinite',
                fadeUp: 'fadeUp 1s ease forwards',
                pulseGlow: 'pulseGlow 5s infinite',
            },
            keyframes: {
                float: {
                    '0%,100%': { transform: 'translateY(0px)' },
                    '50%': { transform: 'translateY(-10px)' }
                },
                fadeUp: {
                    '0%': {
                        opacity: 0,
                        transform: 'translateY(40px)'
                    },
                    '100%': {
                        opacity: 1,
                        transform: 'translateY(0px)'
                    }
                },
                pulseGlow: {
                    '0%,100%': { opacity: .4 },
                    '50%': { opacity: 1 }
                }
            }
        }
    }
}
</script>

<style>

*{
    scroll-behavior:smooth;
}

body{
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
    background:#F5F5F7;
    color:#111827;
}

.dark body{
    background:#050505;
    color:white;
}

.glass{
    background:rgba(255,255,255,.7);
    backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);
    border:1px solid rgba(0,0,0,.05);
    box-shadow:
        0 10px 30px rgba(0,0,0,.04),
        inset 0 1px 0 rgba(255,255,255,.8);
}

.dark .glass{
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.08);
    box-shadow:none;
}

.hero-gradient{
    background:
    radial-gradient(circle at top left, rgba(99,102,241,.12), transparent 35%),
    radial-gradient(circle at bottom right, rgba(168,85,247,.10), transparent 35%);
}

.glow{
    position:absolute;
    width:500px;
    height:500px;
    border-radius:999px;
    filter:blur(100px);
    z-index:0;
}

.nav-blur{
    background:rgba(255,255,255,.75);
    backdrop-filter:blur(18px);
    border-bottom:1px solid rgba(0,0,0,.05);
}

.dark .nav-blur{
    background:rgba(10,10,10,.7);
    border-bottom:1px solid rgba(255,255,255,.05);
}

.text-gradient{
    background:linear-gradient(to right,#111827,#7c3aed,#2563eb);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.dark .text-gradient{
    background:linear-gradient(to right,#ffffff,#a78bfa,#60a5fa);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.section-title{
    font-size:clamp(2.2rem,5vw,5rem);
    line-height:1;
    font-weight:900;
    letter-spacing:-0.05em;
}

.card-hover{
    transition:all .4s cubic-bezier(.16,1,.3,1);
}

.card-hover:hover{
    transform:translateY(-8px);
}

.project-image{
    transition:transform .7s cubic-bezier(.16,1,.3,1);
}

.project-card:hover .project-image{
    transform:scale(1.08);
}

.fade-section{
    opacity:0;
    transform:translateY(50px);
    transition:all 1s ease;
}

.fade-section.show{
    opacity:1;
    transform:translateY(0px);
}

.tech-marquee{
    white-space:nowrap;
    overflow:hidden;
    position:relative;
}

.tech-track{
    display:inline-block;
    padding-left:100%;
    animation:marquee 25s linear infinite;
}

@keyframes marquee{
    0%{
        transform:translateX(0);
    }
    100%{
        transform:translateX(-100%);
    }
}

.mobile-link{
    font-size:1rem;
    font-weight:500;
    transition:.3s;
}

.mobile-link:hover{
    transform:translateX(4px);
}

::-webkit-scrollbar{
    width:8px;
}

::-webkit-scrollbar-thumb{
    background:#D4D4D8;
    border-radius:999px;
}

</style>
</head>

<body class="transition-colors duration-500">

